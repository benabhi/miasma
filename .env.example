# Copiar a .env y ajustar. .env está en .gitignore.

# --- Base de datos ---------------------------------------------------------
POSTGRES_DB=miasma
POSTGRES_USER=miasma
POSTGRES_PASSWORD=cambiame

# --- Runtime ---------------------------------------------------------------
# Versión de Evennia que instala la imagen. Cambiarla exige reconstruir:
#   docker compose build --no-cache game
EVENNIA_VERSION=6.1.0

# 1 = DEBUG de Django activo (tracebacks completos en el navegador). Dejar en 0
# en cualquier cosa que mire hacia afuera.
MIASMA_DEBUG=1

# --- Cuenta #1 (superusuario / dueño del server) ---------------------------
# Evennia las lee cuando detecta que la Cuenta #1 no existe y la crea sin
# interacción. Si faltan, el contenedor se cuelga en un prompt interactivo.
EVENNIA_SUPERUSER_USERNAME=admin
EVENNIA_SUPERUSER_EMAIL=admin@miasma.local
EVENNIA_SUPERUSER_PASSWORD=cambiame
