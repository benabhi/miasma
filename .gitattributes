# Los scripts que corren dentro de contenedores Linux deben conservar LF
# aunque se editen desde Windows.
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# TinTin++ es un programa Unix: con finales CRLF el retorno de carro se cuela
# dentro de los argumentos y el cliente termina buscando un archivo llamado
# "miasma/nebrida.map", que no existe. Da un NOT FOUND que parece un
# problema de rutas y no lo es.
*.tin text eol=lf
*.map text eol=lf
